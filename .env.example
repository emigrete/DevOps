# =========================================================
#  PLANTILLA DE VARIABLES DE ENTORNO
#  Copiar este archivo a `.env` y completar con valores reales.
#  El archivo `.env` NUNCA se sube a git (está en .gitignore).
# =========================================================

# --- Aplicación ---
APP_NAME=tp-devops-api
APP_ENV=development
APP_PORT=8000

# --- Base de datos ---
# Para desarrollo local con SQLite:
DATABASE_URL=sqlite:///./app.db
# Para docker-compose con Postgres (Fase 2):
# DATABASE_URL=postgresql://devops:devops@db:5432/tpdevops
POSTGRES_USER=devops
POSTGRES_PASSWORD=devops
POSTGRES_DB=tpdevops

# --- API externa (Pokemon) usada para las trazas en monitoreo (Clase 4) ---
POKEAPI_BASE_URL=https://pokeapi.co/api/v2

# --- New Relic (Fase 6 - Monitoreo) ---
# Bonanni mostró estas variables exactas en Clase 6
NEW_RELIC_LICENSE_KEY=your_license_key_here
NEW_RELIC_APP_NAME=tp-devops-api
NEW_RELIC_CONFIG_FILE=newrelic.ini
